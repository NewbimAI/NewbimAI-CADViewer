<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CADViewer</AssemblyName>
    <RootNamespace>CadViewer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 单文件 + 自包含：目标机器不需要装 .NET -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Version>0.1.0</Version>
    <Product>CADViewer</Product>
    <Company>NewbimAI</Company>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!--
    构建时把便携包 zip 作为嵌入资源塞进 exe。
    仓库里没有这个 zip（release/ 被忽略），所以用 PayloadPath 传入；
    未传时仍能编译（只是运行时会报 payload missing）。
  -->
  <ItemGroup Condition="'$(PayloadPath)' != ''">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
