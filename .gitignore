# ============================================================
#  依赖
# ============================================================
node_modules/
.pnp
.pnp.js

# ============================================================
#  构建产物
# ============================================================
# 构建产物（web/dist 例外：必须随仓库分发，否则 clone 后要先 npm install + vite build 才能开界面）
dist/
!web/dist/
!web/dist/**
build/
out/
*.tsbuildinfo

# ============================================================
#  运行时数据（绝不公开）
# ============================================================
# 可随时删的派生缓存：转换产物、Web DXF、导出件
server/cache/

# 用户上传的原始图纸：属隐私数据，绝不公开（只放行目录说明）
/data/*
!/data/README.md

# Skill/CLI 文档示例的输出物（含图纸派生数据，别误提交）
out.pdf
out.svg
out.png
out-stats.json

# 图纸文件本身：不管出现在哪个目录、什么大小写，都不提交
*.dwg
*.DWG
*.dxf
*.DXF
*.dwf
*.DWF

# ============================================================
#  第三方转换器（体积大，需单独下载）
# ============================================================
# cadcraft 便携版约 127MB，不适合进仓库；使用说明见 README
bin/cadcraft/
# udo-cli（Rust，crates/ 构建产物）：体积大 + 闭源分发，README「自定义对象解析」有构建命令
bin/udo-cli/
# 0.3.0 之前的旧目录名：过渡期保留，避免旧安装包/旧构建产物被误提交
bin/tch-cli/
bin/*.zip
bin/*.tar.gz

# 本地打包产物（免安装便携版），由 scripts/build-portable.mjs 生成
release/

# .NET 构建中间产物（单文件启动器，scripts/build-sfx.mjs）
scripts/SfxLauncher/bin/
scripts/SfxLauncher/obj/

# ============================================================
#  内部资料（绝不公开）
# ============================================================
# 开发记忆、快照、内部文档：含内部策略与未公开计划
.workbuddy/
.snapshots/
.opencode/
# docs/ 全部属于内部过程资料（路线图、解码笔记、复现报告、诊断截图、发版草稿），
# 一律不入仓库——包括子目录，不留任何白名单。
docs/

# ============================================================
#  测试目录：本机开发脚本，不入库
# ============================================================
# 探针脚本含本机绝对路径与内部目录约定，且多数属于已下线的 SVG 引擎时代，
# 不适合公开。需要时请自行留档。
test/*
.playwright-mcp/
# 调试截图（含历史遗留）
.*-check.png
.lod-check.png

# ============================================================
#  日志 / 临时文件
# ============================================================
*.log
logs/
tmp/
temp/
*.tmp
*.cache

# web 组件库的历史备份：.bak 文件与已下线的 shadcn 变体目录（本机回滚用，不发布）
web/.bak-ui/
*.bak

# ============================================================
#  环境变量 / 密钥
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

