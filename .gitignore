*.heapsnapshot
*.cpuprofile
*.trace
coverage/
*.orig
*.rej
*.tgz

# ============================================================
#  Rust / .NET 构建缓存
# ============================================================
target/
obj/
bin/Debug/
bin/Release/

# ============================================================
#  Rust 自定义对象解析：闭源边界（0.3.0 起）
#  crates/ 是闭源实现，只在本机存在、只发布 bin/udo-cli/udo-cli.exe；
#  源码与 Cargo 清单一律不入库，避免 git add -A 误提交。
# ============================================================
crates/
Cargo.toml
Cargo.lock
.cargo/

# ============================================================
#  一次性实验目录 / 原生二进制
# ============================================================
scratch/
*.exe
*.dll
*.pdb
# 例外：随仓库分发的前端/工具脚本不涉及可执行文件，无需白名单

